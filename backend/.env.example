# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env          (Git Bash / Linux / macOS)
#   copy .env.example .env        (CMD / PowerShell)
#
# As variaveis sem valor padrao abaixo sao OBRIGATORIAS: settings.py as le com
# python-decouple sem default, entao o Django nao sobe se faltar alguma. As
# opcionais estao marcadas como tal.

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

# Use True apenas em desenvolvimento
DEBUG=True

# Hosts autorizados a responder, separados por virgula.
# Obrigatorio preencher com o dominio real antes de qualquer deploy.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens autorizadas no CORS/CSRF (o front roda na 7777).
CORS_ALLOWED_ORIGINS=http://localhost:7777,http://127.0.0.1:7777

# PostgreSQL - desenvolvimento (banco local)
DB_NAME=gestaopecuariadb
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL - producao (OPCIONAL em desenvolvimento; deixe em branco/ausente)
#
# O provedor gerenciado entrega uma url unica no lugar das cinco variaveis
# acima. Quando DATABASE_URL esta preenchida, ela GANHA e as cinco sao
# ignoradas - entao nao preencha as duas por engano achando que uma completa a
# outra.
#
# Use sempre o endpoint com POOLER (o host termina em '-pooler'), e nunca
# comite esta url: ela contem a senha do banco.
#
# DATABASE_URL=postgresql://usuario:senha@host-pooler.regiao.provedor.tech/banco?sslmode=require

# HSTS em segundos (OPCIONAL; so tem efeito com DEBUG=False; padrao 3600).
#
# Suba para 31536000 (1 ano) depois de uma semana no ar sem problema. O valor
# fica gravado no navegador do visitante pelo tempo declarado e nao ha como
# cancelar do lado do servidor - por isso o padrao e conservador.
#
# SECURE_HSTS_SECONDS=3600
