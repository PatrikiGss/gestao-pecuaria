# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env          (Git Bash / Linux / macOS)
#   copy .env.example .env        (CMD / PowerShell)
#
# Todas as variaveis abaixo sao OBRIGATORIAS: settings.py as le com
# python-decouple sem valor padrao, entao o Django nao sobe se faltar alguma.

# Chave secreta do Django. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-gerada

# Use True apenas em desenvolvimento
DEBUG=True

# PostgreSQL
DB_NAME=gestaopecuariadb
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres
DB_HOST=localhost
DB_PORT=5432
